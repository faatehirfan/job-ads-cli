{
    "name": "faatehirfan/job-ads-cli",
    "description": "List, filter and summarise job ads from the command line",
    "type": "project",
    "require": {
        "php": "^8.5"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "JobAds\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Fatih Irfan",
            "email": "fathirfnz@gmail.com"
        }
    ],
    "require-dev": {
        "pestphp/pest": "^5.3"
    },
    "scripts": {
        "test": "pest",
        "lint": [
            "pint --test",
            "phpstan analyse --no-progress"
        ],
        "fix": "pint"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
